# Copy to .env and fill in real values.
# .env is gitignored. Never commit real tokens.

# Remote Turso database. Leave unset for local file database.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Overrides TURSO_DATABASE_URL. Set to file:local.db to force local disk.
DATABASE_URL=

# Port for the Node server.
PORT=3000
